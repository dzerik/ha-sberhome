{
  "config": {
    "step": {
      "user": {
        "title": "Connect to SberHome",
        "description": "Choose how to authorize with Sber smart home.",
        "menu_options": {
          "sberid": "Sber ID (browser, recommended)",
          "sms": "Phone number + SMS code (beta)"
        }
      },
      "sberid": {
        "title": "Authorize via Sber ID"
      },
      "sms_phone": {
        "title": "Sign in via SMS (beta)",
        "description": "Enter the phone number registered with Sber Home. Format: {example_phone}. We'll send a one-time SMS code.",
        "data": {
          "phone": "Phone number"
        }
      },
      "sms_otp": {
        "title": "Enter the SMS code",
        "description": "We sent a one-time code to {phone}.",
        "data": {
          "otp": "SMS code"
        }
      },
      "reauth_confirm": {
        "title": "[%key:common::config_flow::title::reauth%]",
        "description": "The SberHome authorization token has expired. Please sign in again ({method})."
      }
    },
    "abort": {
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "already_configured": "[%key:common::config_flow::abort::already_configured_account%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
      "wrong_account": "Signed in with a different Sber account than the original config entry. Sign in again with the correct account.",
      "cannot_connect": "Could not reach Sber servers. Check the connection and try again.",
      "no_url_available": "No accessible Home Assistant URL is configured. Set an external or internal URL in Settings → System → Network and try again."
    },
    "error": {
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]",
      "invalid_phone": "Invalid phone number. Use international format like 78001234567.",
      "send_otp_failed": "Could not send the SMS code. Verify the number and try again later.",
      "invalid_otp": "The SMS code is wrong or expired. Request a new one if needed."
    },
    "create_entry": {
      "default": "Authorization successful. **No devices were imported automatically** — open the SberHome panel in the sidebar (or go to [/sberhome](/sberhome)) and pick which devices you want in Home Assistant. Until then the integration is connected but exposes no entities."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "SberHome Settings",
        "data": {
          "scan_interval": "Scan interval (seconds)"
        },
        "data_description": {
          "scan_interval": "How often to poll the API for device state updates (10 to 300 seconds)"
        }
      }
    }
  },
  "services": {
    "send_custom_key": {
      "name": "Send custom key",
